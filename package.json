{
  "name": "agentcorp",
  "version": "0.1.0",
  "private": true,
  "description": "AgentCorp \u2014 a fully autonomous AI-run business. Phase 1: scaffold, DB schema, LLM provider.",
  "type": "commonjs",
  "main": "desktop/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "migrate": "npm run build && node dist/db/migrate.js",
    "demo:llm": "npm run build && node dist/scripts/demo-llm.js",
    "demo:agent": "npm run build && node dist/scripts/demo-agent.js",
    "demo:goal": "npm run build && node dist/scripts/demo-goal.js",
    "demo:tools": "npm run build && node dist/scripts/demo-tools.js",
    "demo:critic": "npm run build && node dist/scripts/demo-critic.js",
    "demo:brain": "npm run build && node dist/scripts/demo-brain.js",
    "demo:safety": "npm run build && node dist/scripts/demo-safety.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "build:all": "npm run build && npm run frontend:build",
    "setup": "npm install && npm run frontend:install && npm run build:all",
    "desktop": "npm run build:all && electron desktop/main.js",
    "desktop:dev": "electron desktop/main.js",
    "package": "npm run build:all && electron-builder",
    "package:dir": "npm run build:all && electron-builder --dir",
    "rebuild:electron": "node -e \"const v=require('electron/package.json').version;const{execSync}=require('child_process');execSync('npm rebuild better-sqlite3 --runtime=electron --target='+v+' --dist-url=https://electronjs.org/headers --build-from-source',{stdio:'inherit'})\"",
    "rebuild:node": "npm rebuild better-sqlite3",
    "seed": "npm run build && node dist/scripts/seed-brain.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "sqlite-vec": "^0.1.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "electron": "^43.2.0",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.agentcorp.app",
    "productName": "AgentCorp",
    "directories": {
      "output": "release",
      "buildResources": "desktop/resources"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "frontend/dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "agents",
        "to": "app/agents"
      },
      {
        "from": "company_handbook.md",
        "to": "app/company_handbook.md"
      },
      {
        "from": ".env.example",
        "to": "app/.env.example"
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/sqlite-vec/**"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}
