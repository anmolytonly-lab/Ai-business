# ── AgentCorp environment ──────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Gemini API key (https://aistudio.google.com/apikey) — REQUIRED for LLM calls
GEMINI_API_KEY=

# Default model for agents that don't specify one
GEMINI_MODEL=gemini-2.5-flash

# HTTP server
PORT=3000

# SQLite database file (created on first run)
DATABASE_PATH=./data/agentcorp.db

# Budget guard (used from Phase 7 on; recorded per-call from Phase 1)
# Daily spend cap in USD across all agents. Hard stop + alert at 80%.
DAILY_BUDGET_USD=5.00

# Agent filesystem sandbox. Agents can never read or write outside this
# directory — absolute paths, ".." traversal and symlink escapes are rejected.
AGENT_WORKSPACE_ROOT=./workspace

# Extra shell commands to whitelist, comma-separated (e.g. "git,make").
# The safe default excludes rm, mv, sudo, curl, wget and git.
SHELL_WHITELIST_EXTRA=

# Company Brain. Changing the model or dimensions requires re-embedding every
# document (delete data/agentcorp.db or re-add the documents).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# How many knowledge-base chunks are injected into an agent's prompt.
BRAIN_TOP_K=4
