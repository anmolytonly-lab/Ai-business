# ── AgentCorp environment ──────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Gemini API key (https://aistudio.google.com/apikey) — REQUIRED for LLM calls
GEMINI_API_KEY=

# Default model for agents that don't specify one
GEMINI_MODEL=gemini-2.5-flash

# HTTP server
PORT=3000

# SQLite database file (created on first run)
DATABASE_PATH=./data/agentcorp.db

# Budget guard. Company-wide daily spend cap in USD: agents are alerted at 80%
# and hard-stopped at 100%. Per-agent daily cap stops one runaway agent from
# consuming the whole budget. Set either to 0 to disable that cap.
DAILY_BUDGET_USD=5.00
AGENT_DAILY_BUDGET_USD=2.00

# Agent filesystem sandbox. Agents can never read or write outside this
# directory — absolute paths, ".." traversal and symlink escapes are rejected.
AGENT_WORKSPACE_ROOT=./workspace

# Extra shell commands to whitelist, comma-separated (e.g. "git,make").
# The safe default excludes rm, mv, sudo, curl, wget and git.
SHELL_WHITELIST_EXTRA=

# Company Brain. Changing the model or dimensions requires re-embedding every
# document (delete data/agentcorp.db or re-add the documents).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# How many knowledge-base chunks are injected into an agent's prompt.
BRAIN_TOP_K=4

# Autonomous routines (daily standup, content, weekly metrics, HR review,
# monthly P&L, memory compaction). OFF by default so nothing runs unattended
# until you choose it. Routines can always be fired by hand from the dashboard.
SCHEDULER_ENABLED=false

# ── Integrations ───────────────────────────────────────────────────────
# All adapters ship as clearly-marked STUBS. Leave these blank and the system
# runs fully — agents are told the source is unavailable rather than inventing
# data. Filling them in marks an adapter "credentials set"; the live request
# path still needs implementing per adapter.

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_ID=

NOTION_API_KEY=
NOTION_DATABASE_ID=

STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

GA_PROPERTY_ID=
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=
